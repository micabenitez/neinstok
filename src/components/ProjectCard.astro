---
interface Props {
  title: string;
  image: string;
  audio: string;
  large?: boolean;
  subtitle?: string;
  description?: string;
  category?: string;
}

const { title, image, subtitle } = Astro.props;
---

<button 
    class={`project-card-trigger relative w-full h-full text-left rounded-3xl overflow-hidden group cursor-pointer flex items-end transition-transform duration-300 hover:scale-[1.02] focus:outline-none focus:ring-4 focus:ring-white/30`}
    data-title={title}
    aria-label={`Reproducir proyecto ${title}`}
>
    <img 
        src={image} 
        alt="" 
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover opacity-100 group-hover:opacity-75 transition duration-500 ease-in-out"
    />
        
    <div class="absolute top-5 left-5 z-20 w-12 h-12 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center group-hover:bg-white group-hover:text-black transition-colors duration-300 text-white shadow-lg">
        <svg class="icon-play w-6 h-6 ml-1 block" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <svg class="icon-pause w-6 h-6 hidden" viewBox="0 0 24 24" fill="currentColor">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
        </svg>
    </div>
    
    <div class="relative z-10 text-white font-bold tracking-wide text-lg pb-6 pl-8 drop-shadow-md">
        {title}
        {subtitle && <p class="text-xs font-normal opacity-90 mt-1">{subtitle}</p>}
    </div>
</button>