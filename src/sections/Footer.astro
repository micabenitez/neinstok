---
import HeroLogo from "@/components/logos/HeroLogo.astro";
import SpotifyLogo from "@/components/logos/SpotifyLogo.astro";
import InstagramLogo from "@/components/logos/InstagramLogo.astro";
import YoutubeLogo from "@/components/logos/YoutubeLogo.astro";
import TiktokLogo from "@/components/logos/TiktokLogo.astro";
import AppleMusicLogo from "@/components/logos/AppleMusicLogo.astro";
---

<footer class="bg-primary w-full min-h-80 p-8 md:px-10 md:py-10 relative">
  <div class="max-w-7xl mx-auto sm:px-0 lg:px-16 lg:pt-10">
    
    <div class="flex justify-between mb-8 md:mb-20 items-center flex-wrap gap-10">
      <div class="flex gap-7 items-center">
          <HeroLogo class="w-20 h-20 text-white" />
        <div class="w-1 rounded-2xl h-16 md:h-24 bg-white"></div>
        <p class="text-sm md:text-justify md:text-lg text-white max-w-xl">
          Tu música es importante. <br>La tratamos con el respeto y la calidad que
          merece.
        </p>
      </div>

      <div class="flex flex-col text-white gap-4">
          <div class="mb-3">
            <h3 class="font-bold text-lg tracking-wide">Contacto</h3>
            <a
              href="mailto:neinstok.contact@gmail.com"
              class="text-gray-300 hover:text-secondary transition-colors duration-300 text-sm md:text-base break-all"
            >
              neinstok.contact@gmail.com
            </a>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-1 md:mb-3 tracking-wide">Sígueme</h3>
            <div class="flex justify-between py-1">
                <a
                href="https://www.instagram.com/neinstok/"
                target="_blank"
                rel="noopener noreferrer"
                ><InstagramLogo class="bg-white rounded-full p-1"/></a
                >
                <a
                href="https://www.youtube.com/@neinstok?sub_confirmation=1"
                target="_blank"
                rel="noopener noreferrer"
                ><YoutubeLogo class="bg-white rounded-full p-1"/></a
                >
                <a
                href="https://www.tiktok.com/@neinstok"
                target="_blank"
                rel="noopener noreferrer"
                ><TiktokLogo class="bg-white rounded-full p-1"/></a
                >
                <a
                    href="https://open.spotify.com/intl-es/artist/6txpqJ5dBPNz3aioQidxF0"
                    target="_blank"
                    rel="noopener noreferrer"
                    >
                    <SpotifyLogo  />
                </a
                >
                <a
                    href="https://music.apple.com/ar/artist/neinstok/6792768141"
                    target="_blank"
                    rel="noopener noreferrer"
                    ><AppleMusicLogo class="bg-white rounded-full p-1"/></a
                >
            </div>
          </div>
      </div>
    </div>

    <div class="flex flex-wrap gap-4 justify-between md:mt-10 border-t-2 py-5 text-gray-200 border-gray-700">
      <p>Developed by <a href="https://github.com/micabenitez" target="_blank" rel="noopener noreferrer" class="hover:text-secondary transition-colors duration-300"><span class="font-semibold">Micaela Benitez</span></a></p>
      <p class="col-span-1 sm:col-span-2 lg:col-span-1 order-3 sm:order-2 lg:order-2">
        © 2026 - Todos los derechos reservados
      </p>
      <p class="col-span-1 sm:col-span-2 lg:col-span-1 order-2 sm:order-3 lg:order-3">
        <a
          href="https://drive.google.com/file/d/1GaDlaczGw6dVu0aHW2DPsryk5x1uxtki/view"
          target="_blank"
          class=" hover:text-secondary transition-colors duration-300"
          >Términos y condiciones
        </a>
      </p>
    </div>
  </div>
</footer>