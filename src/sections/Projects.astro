---
import ProjectCard from "@/components/ProjectCard.astro";
---

<section class="py-10">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-lg font-bold mb-16 tracking-widest">_PROYECTOS</h2>
    
    <div class="grid grid-cols-3 gap-y-8 mb-12 px-16">
      <ProjectCard 
        title="Artist" 
        image="/img/skl.webp" 
        bgColor="bg-black" 
        large={true}
      />
      <ProjectCard 
        title="Pop/Radio" 
        image="/img/pop-indie.webp" 
        bgColor="bg-red-600" 
      />
      <ProjectCard 
        title="Rock/Metal" 
        image="/img/rock-metal.webp" 
        bgColor="bg-gray-500" 
      />
      <ProjectCard 
        title="Urbano" 
        image="/img/urbano.webp" 
        bgColor="bg-orange-600" 
      />
      <ProjectCard 
        title="Podcast" 
        image="/img/podcast.webp" 
        bgColor="bg-black" 
      />
    </div>

    <div class="text-center">
      <p class="text-gray-600 mb-2">
        ¿Te gustó lo que escuchaste?
        <a href="#contact" class="text-secondary font-bold hover:underline">Contáctame</a>
      </p>
    </div>
  </div>
</section>
