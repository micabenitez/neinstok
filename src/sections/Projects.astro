---
import ProjectCard from "@/components/ProjectCard.astro";
import { ProjectPlayer } from "@/components/ProjectPlayer";
import { projectsData } from "@/data/projects";
---

<section class="p-8 md:py-16 w-full sm:px-6 lg:px-12 mb-8" id="projects">
  <div class="max-w-6xl mx-auto">
    <h2 class="mb-12 text-sm md:text-base font-bold text-left opacity-70">
      _PROYECTOS
    </h2>

    <div
      id="carousel-container"
      class="projects-layout flex px-4 md:px-8 lg:px-16 overflow-x-auto snap-x snap-mandatory gap-4 pb-6 md:pb-0 scrollbar-hide"
    >
      {
        projectsData.map((project, index) => {
          const areas = ['artist', 'pop', 'urbano', 'podcast'];
          const gridArea = areas[index] || '';

          return (
            <div 
              class="shrink-0 snap-center w-80 h-80 md:w-full md:h-full"
              style={`grid-area: ${gridArea};`}
            >
              <ProjectCard {...project} />
            </div>
          );
        })
      }
    </div>

    <ProjectPlayer client:idle />

    <div class="text-center px-4">
      <p class="text-gray-600 mt-10 text-sm sm:text-base md:text-lg">
        ¿Te gustó lo que escuchaste?
        <a href="#contact" class="text-secondary font-bold hover:underline ml-2">Contáctame</a>
      </p>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide {
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) {
    .projects-layout {
      display: grid;
      overflow-x: visible; 
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: 300px 280px; 
      gap: 1.5rem;
      grid-template-areas:
        "artist pop pop"
        "artist urbano podcast";
    }
  }
</style>

<script>
  import { projectsData } from '../data/projects'; 
  import { useAudioStore } from '../stores/playerStore';

  const cards = document.querySelectorAll('.project-card-trigger');
  
  cards.forEach(card => {
    const el = card as HTMLButtonElement;
    el.addEventListener('click', () => {
      const cardTitle = el.dataset.title;
      const fullProjectData = projectsData.find(p => p.title === cardTitle);

      if (!fullProjectData) return;

      const { activeProject, isOpen, togglePlay, openPlayer } = useAudioStore.getState();

      if (activeProject && activeProject.title === fullProjectData.title && isOpen) {
          togglePlay();
      } else {
          openPlayer(fullProjectData);
      }
    });
  });

  function updateAllCards() {
    const { activeProject, isOpen, isPlaying } = useAudioStore.getState();

    cards.forEach(card => {
        const el = card as HTMLButtonElement;
        const cardTitle = el.dataset.title;
        const playIcon = el.querySelector('.icon-play');
        const pauseIcon = el.querySelector('.icon-pause');

        const isActiveAndPlaying = isOpen && activeProject && activeProject.title === cardTitle && isPlaying;

        if (isActiveAndPlaying) {
            playIcon?.classList.add('hidden');
            pauseIcon?.classList.remove('hidden');
        } else {
            playIcon?.classList.remove('hidden');
            pauseIcon?.classList.add('hidden');
        }
    });
  }

  useAudioStore.subscribe(updateAllCards);
  updateAllCards();

  const carouselContainer = document.getElementById("carousel-container");
  const carouselPrev = document.getElementById("carousel-prev");
  const carouselNext = document.getElementById("carousel-next");

  if (carouselContainer) {
    const scrollAmount = 320;

    if (carouselNext) {
      carouselNext.addEventListener("click", () => {
        carouselContainer.scrollBy({ left: scrollAmount, behavior: "smooth" });
      });
    }

    if (carouselPrev) {
      carouselPrev.addEventListener("click", () => {
        carouselContainer.scrollBy({ left: -scrollAmount, behavior: "smooth" });
      });
    }

    carouselContainer.addEventListener("wheel", (e) => {
      if (window.innerWidth < 768) {
         e.preventDefault();
         carouselContainer.scrollBy({
           left: e.deltaY > 0 ? scrollAmount : -scrollAmount,
           behavior: "smooth",
         });
      }
    });
  }
</script>