---
---

<section class="py-20 -mx-10 px-10">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-lg font-bold mb-8 tracking-widest">_SERVICIOS</h2>
        
        <h3 class="text-4xl font-bold text-center mb-16">Tu sonido, único, el proceso, simple.</h3>

        {/* Grid de servicios */}
        <div class="grid grid-cols-3 gap-8 mb-12">
            {/* Producción */}
            <div class="bg-gray-100 rounded-2xl p-8 text-center hover:shadow-lg transition">
                <div class="flex justify-center mb-6">
                    <svg class="w-12 h-12 text-gray-800" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 3v2.25m6.364.386l-1.591 1.591M21 12a9 9 0 11-18 0 9 9 0 0118 0m0 0v-6.75m-8.25 8.25h.007v.007h-.007v-.007zm3 0h.007v.007h-.007v-.007zm3 0h.007v.007h-.007v-.007z" />
                    </svg>
                </div>
                <h4 class="text-xl font-bold mb-2">PRODUCCIÓN</h4>
                <div class="w-12 h-1 bg-secondary mx-auto"></div>
            </div>

            {/* Mezcla */}
            <div class="bg-gray-100 rounded-2xl p-8 text-center hover:shadow-lg transition">
                <div class="flex justify-center mb-6">
                    <svg class="w-12 h-12 text-secondary" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M3 4.5h18M3 9h18M3 13.5h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </div>
                <h4 class="text-xl font-bold mb-2">MEZCLA</h4>
                <div class="w-12 h-1 bg-secondary mx-auto"></div>
            </div>

            {/* Mastering */}
            <div class="bg-gray-100 rounded-2xl p-8 text-center hover:shadow-lg transition">
                <div class="flex justify-center mb-6">
                    <svg class="w-12 h-12 text-gray-800" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                    </svg>
                </div>
                <h4 class="text-xl font-bold mb-2">MASTERING</h4>
                <div class="w-12 h-1 bg-secondary mx-auto"></div>
            </div>
        </div>

        {/* CTA */}
        <div class="text-center">
            <p class="text-gray-600 mb-6">Descubre qué servicio se adapta a ti</p>
            <button class="bg-secondary hover:bg-red-700 uppercase font-extrabold text-white rounded-xl py-3 px-8 transition">
                Contratarme Ahora
            </button>
        </div>
    </div>
</section>
