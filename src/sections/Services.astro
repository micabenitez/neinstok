---
import Production from "@/components/icons/Production.astro";
import Mixing from "@/components/icons/Mixing.astro";
import Mastering from "@/components/icons/Mastering.astro";

const services = [
  {
    title: "PRODUCCIÓN",
    Icon: Production,
    color: "bg-primary",
    description: "Damos vida a tus ideas desde cero, creando instrumentales y arreglos que definen tu sonido único."
  },
  {
    title: "MEZCLA",
    Icon: Mixing,
    color: "bg-secondary",
    description: "Equilibramos cada elemento para darle claridad, espacio y potencia a tu música."
  },
  {
    title: "MASTERING",
    Icon: Mastering,
    color: "bg-primary",
    description: "Optimizamos volumen, brillo y consistencia para que tu tema compita al nivel de la industria en cualquier plataforma."
  },
];
---

<section class="py-10 md:py-18 bg-white sm:px-6 lg:px-8" id="services">
    <div class="max-w-6xl mx-auto">
        <div class="md:mb-16">
            <h2 class="text-sm md:text-base font-bold mb-4 text-left opacity-70">
                _SERVICIOS
            </h2>
            <h3 class="text-lg md:text-3xl lg:text-4xl font-bold text-center leading-tight">
                Tu sonido, <span class="text-secondary">único.</span> El proceso, <span class="text-secondary">simple.</span>
            </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 md:mb-16 p-8">
            {services.map(({ title, Icon, color, description }) => (
                <article class="group relative flex flex-col items-start justify-between bg-gray-100 rounded-3xl 
                p-6 md:p-8 min-h-72 w-full transition-all duration-300 ease-out
                md:hover:shadow-xl md:hover:-translate-y-2 
                focus-within:ring-2 focus-within:ring-primary cursor-pointer"
            >
                <div class="md:group-hover:scale-110 transition-transform duration-300 origin-left">
                    <Icon class="md:group-hover:opacity-60 transition-opacity duration-300" /> 
                </div> 
                
                <div class="w-full">
                    <h4 class="text-xl font-bold mb-2 tracking-wider text-gray-800 transition-colors duration-300">{title}</h4>
                    
                    <p class="text-gray-600 mb-4 transition-colors duration-300 text-sm font-semibold leading-relaxed 
                              block md:hidden md:group-hover:block">
                        {description}
                    </p>
                    
                    <div class={`w-8 h-1.5 ${color} rounded-full transition-all duration-300 md:group-hover:w-12`}></div>                    
                </div>
            </article>
            ))}                       
        </div>

        <div class="text-center px-4">
            <p class="text-gray-600 mb-6 text-base md:text-lg">Descubre qué servicio se adapta a ti</p>
            
            <a href="#contact" class="text-white hover:text-gray-300 ">
                <button class="bg-secondary hover:bg-red-700 active:scale-95 uppercase font-extrabold text-white 
                            rounded-xl min-h-12 w-full max-w-xs transition-all duration-300 shadow-md hover:shadow-lg
                            px-5 py-2 md:py-4 md:px-10 md:w-full sm:w-auto text-sm md:text-base tracking-widest cursor-pointer">
                    Contratarme Ahora
                </button>
            </a>
        </div>
    </div>
</section>
