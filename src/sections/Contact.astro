---
// Contact.astro
---

<section class="p-8 md:py-16 w-full sm:px-6 lg:px-12 mb-8" id="contact">
  <div class="max-w-6xl mx-auto">
    <div class="mb-12 md:mb-16">
      <h2 class="text-sm md:text-base font-bold mb-4 text-left opacity-70">
        _CONTACTO
      </h2>
      <h3 class="text-3xl md:text-3xl lg:text-4xl font-medium leading-tight text-gray-900 text-center my-10">
        Lleva tu sonido al siguiente nivel. <span class="text-secondary">Escríbeme.</span>
      </h3>
    </div>

    <div class="tally-wrapper min-h-125">
      <iframe 
        data-tally-src="https://tally.so/embed/kdAOkZ?hideTitle=1&transparentBackground=1&dynamicHeight=1&formEventsForwarding=1" 
        loading="lazy"
        width="100%" 
        height="500" 
        title="Contacto - Producción Musical">
      </iframe>
    </div>
  </div>
</section>

<script is:inline>
  function loadTally() {
    const w = "https://tally.so/widgets/embed.js";
    const d = document;
    
    const v = () => {
      if (typeof Tally !== 'undefined') {
        Tally.loadEmbeds();
      } else {
        d.querySelectorAll('iframe[data-tally-src]:not([src])').forEach(e => {
          e.src = e.dataset.tallySrc;
        });
      }
    };

    if (typeof Tally !== 'undefined') {
      v();
    } else if (d.querySelector(`script[src="${w}"]`) === null) {
      const s = d.createElement("script");
      s.src = w;
      s.onload = v;
      s.onerror = v;
      d.body.appendChild(s);
    } else {
      v();
    }
  }

  loadTally();
  document.addEventListener('astro:page-load', loadTally);
</script>

<style>
  .tally-wrapper {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
</style>