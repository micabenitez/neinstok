---
import HeroLogo from "@/components/logos/HeroLogo.astro";

const linkStyles = "font-semibold hover:text-secondary transition duration-200";
const buttonStyles = "bg-secondary hover:bg-red-700 text-white font-extrabold uppercase rounded-xl py-2 px-6 transition duration-200 text-sm";
---

<header class="sticky top-0 z-50 flex items-center justify-between border-b border-white/20 bg-gray-50/70 px-4 py-3 backdrop-blur-md sm:px-6 md:px-8">
    
    <HeroLogo class="h-8 w-8 text-secondary sm:h-10 sm:w-10" />

    <nav class="hidden gap-6 text-sm md:flex md:text-base lg:gap-14">
        <a href="#about" class={linkStyles}>SOBRE MÍ</a>
        <a href="#services" class={linkStyles}>SERVICIOS</a>
        <a href="#projects" class={linkStyles}>PROYECTOS</a>
    </nav>

    <button class={`hidden md:block ${buttonStyles}`}>
        Contactar
    </button>

    <button 
        id="menu-toggle" 
        class="flex flex-col gap-1.5 focus:outline-none md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
    >
        <span class="block h-0.5 w-6 origin-center bg-gray-800 transition-transform duration-300"></span>
        <span class="block h-0.5 w-6 origin-center bg-gray-800 transition-opacity duration-300"></span>
        <span class="block h-0.5 w-6 origin-center bg-gray-800 transition-transform duration-300"></span>
    </button>

    <nav 
        id="mobile-menu" 
        class="absolute left-0 right-0 top-full hidden flex-col gap-4 border-b border-white/20 bg-gray-50/95 p-4 backdrop-blur-md md:hidden"
    >
        <a href="#about" class={`${linkStyles} text-lg py-2`}>SOBRE MÍ</a>
        <a href="#services" class={`${linkStyles} text-lg py-2`}>SERVICIOS</a>
        <a href="#projects" class={`${linkStyles} text-lg py-2`}>PROYECTOS</a>
        <button class={`${buttonStyles} w-full mt-2`}>
            Contactar
        </button>
    </nav>

</header>

<style>
    #mobile-menu[data-state="open"] {
        display: flex;
        animation: slideDown 0.2s ease-out forwards;
    }

    #menu-toggle[data-state="open"] span:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }
    
    #menu-toggle[data-state="open"] span:nth-child(2) {
        opacity: 0;
    }
    
    #menu-toggle[data-state="open"] span:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }

    @keyframes slideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('#mobile-menu a');

    const toggleMenu = () => {
        const isOpen = mobileMenu?.getAttribute('data-state') === 'open';
        const newState = isOpen ? 'closed' : 'open';

        mobileMenu?.setAttribute('data-state', newState);
        menuToggle?.setAttribute('data-state', newState);
        menuToggle?.setAttribute('aria-expanded', String(!isOpen));
    };

    menuToggle?.addEventListener('click', toggleMenu);

    links.forEach(link => {
        link.addEventListener('click', () => {
            mobileMenu?.setAttribute('data-state', 'closed');
            menuToggle?.setAttribute('data-state', 'closed');
            menuToggle?.setAttribute('aria-expanded', 'false');
        });
    });
</script>