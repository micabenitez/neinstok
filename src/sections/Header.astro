---
import HeroLogo from "@/components/HeroLogo.astro";

---

<header class="
    sticky top-0 z-50 flex items-center justify-between py-6 px-10 -mx-10 
    backdrop-blur-md bg-gray-50/70 border-b border-white/20">
    
    <HeroLogo class="text-secondary w-10 h-10 ml-8" />    

    <nav class="flex gap-14 text-lg">
        <a href="#about" class="font-semibold  hover:text-secondary transition">SOBRE MÍ</a>
        <a href="#services" class="font-semibold hover:text-secondary transition">SERVICIOS</a>
        <a href="#projects" class="font-semibold hover:text-secondary transition">PROYECTOS</a>
    </nav>

    <button class="bg-secondary hover:bg-red-700 uppercase font-extrabold text-white rounded-xl py-2 px-6 transition">
        Contactar
    </button>
</header>

